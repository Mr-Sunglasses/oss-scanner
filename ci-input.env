NAME=vocagateway
REPO=https://github.com/VocaHQ/vocagateway#oss-scanner
TEST=cd /src && python -m pytest -n 2 -q -p no:cacheprovider; (vocagateway >/tmp/gw.log 2>&1 &) ; for i in $(seq 1 30); do curl -sf localhost:8765/health/live >/dev/null && break; sleep 1; done; curl -s -H "Authorization: Bearer $VOCAGATEWAY_TOKEN" -F file=@/opt/samples/jfk.wav localhost:8765/v1/audio/transcriptions; echo; tail -5 /tmp/gw.log
